# shellcheck shell=bash
# shellcheck disable=SC2034
# =====================================================================
#  Параметры кластера. Всё, что может понадобиться поменять, — здесь.
#  Файл читается скриптами на edge-ноде и подклеивается в начало
#  remote/node.sh, поэтому тут допустимы только простые присваивания.
# =====================================================================

# --- Топология: "имя:IP" для всех узлов, включая edge ---
CLUSTER_HOSTS="team-24-en:10.24.0.10 team-24-nn:10.24.0.11 team-24-00:10.24.0.12 team-24-01:10.24.0.13"

EDGE_HOST="team-24-en"                              # отсюда запускаются скрипты; здесь же HDFS-клиент
EDGE_PUBLIC_HOST="2.59.83.107"                      # внешний адрес edge для SSH и Web UI-туннеля
NAMENODE_HOST="team-24-nn"
SECONDARY_NAMENODE_HOST="team-24-nn"
DATANODE_HOSTS="team-24-nn team-24-00 team-24-01"   # 3 DataNode (узлов под DN всего два, третья — на nn)

CLUSTER_ID="team-24"

# --- SSH с edge на внутренние узлы ---
SSH_USER="team"
SSH_KEY="${HOME}/.ssh/team_internal"

# --- Версии ---
HADOOP_VERSION="3.4.1"
JAVA_MAJOR="11"                                     # Hadoop 3.4 работает на Java 8 и 11
HADOOP_MIRRORS="https://dlcdn.apache.org/hadoop/common https://mirror.yandex.ru/mirrors/apache/hadoop/common https://archive.apache.org/dist/hadoop/common"

# --- Пользователь и пути на узлах ---
HADOOP_USER="hadoop"
INSTALL_DIR="/opt"
JAVA_HOME="/opt/java"                               # симлинк на /opt/jdk-<JAVA_MAJOR>
HADOOP_HOME="/opt/hadoop"                           # симлинк на /opt/hadoop-<HADOOP_VERSION>
DATA_DIR="/data/hadoop"                             # nn/ dn/ snn/ pid/
PID_DIR="/data/hadoop/pid"
LOG_DIR="/var/log/hadoop"

# --- Параметры HDFS ---
NN_RPC_PORT="9000"
NN_HTTP_PORT="9870"
SNN_HTTP_PORT="9868"
DFS_REPLICATION="3"
