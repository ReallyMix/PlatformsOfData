# shellcheck shell=bash
# shellcheck disable=SC2034
# =====================================================================
#  Параметры ДЗ №2: YARN, MapReduce и публикация веб-интерфейсов.
#  Читается ПОСЛЕ ../homework1/config.env, поэтому узлы, пути, пользователь
#  hadoop и версии берутся оттуда. Здесь только то, что относится к YARN.
# =====================================================================

# --- Размещение демонов ---
RESOURCEMANAGER_HOST="team-24-nn"                     # главный демон YARN, рядом с NameNode
NODEMANAGER_HOSTS="team-24-nn team-24-00 team-24-01"  # там же, где DataNode: вычисления рядом с данными
HISTORYSERVER_HOST="team-24-nn"                       # MapReduce JobHistory Server

# --- Порты (стандартные для Hadoop 3) ---
RM_RPC_PORT="8032"
RM_HTTP_PORT="8088"
NM_HTTP_PORT="8042"
JHS_RPC_PORT="10020"
JHS_HTTP_PORT="19888"

# --- Ресурсы, которые каждый NodeManager отдаёт под контейнеры ---
# Должно быть заметно меньше RAM узла: на team-24-nn ещё работают NameNode,
# Secondary NameNode, DataNode, ResourceManager и JobHistory Server.
NM_MEMORY_MB="2048"
NM_VCORES="2"
AM_MEMORY_MB="1024"          # контейнер ApplicationMaster задачи MapReduce
MAP_MEMORY_MB="512"
REDUCE_MEMORY_MB="512"

# --- Публикация веб-интерфейсов через nginx на edge-ноде ---
WEB_AUTH="yes"               # yes — вход по логину/паролю (basic auth), no — без пароля
WEB_USER="team24"            # пароль генерируется при первом запуске в .secrets/web-password
# Список "название:внешний_порт:узел:порт_на_узле".
# Порт снаружи совпадает с родным портом сервиса; для однотипных демонов
# на разных узлах (NodeManager, DataNode) взяты соседние порты.
WEB_UI="namenode:9870:team-24-nn:9870
secondarynamenode:9868:team-24-nn:9868
resourcemanager:8088:team-24-nn:8088
historyserver:19888:team-24-nn:19888
nodemanager-nn:8042:team-24-nn:8042
nodemanager-00:8043:team-24-00:8042
nodemanager-01:8044:team-24-01:8042
datanode-nn:9864:team-24-nn:9864
datanode-00:9865:team-24-00:9864
datanode-01:9866:team-24-01:9864"
