# Шаблонный unit: hadoop-mapred@historyserver (MapReduce JobHistory Server)
[Unit]
Description=Apache Hadoop MapReduce %i
Documentation=https://hadoop.apache.org/docs/r@HADOOP_VERSION@/
After=network-online.target
Wants=network-online.target

[Service]
Type=forking
User=@HADOOP_USER@
Group=@HADOOP_USER@
Environment=HADOOP_IDENT_STRING=@HADOOP_USER@
ExecStart=@HADOOP_HOME@/bin/mapred --daemon start %i
ExecStop=@HADOOP_HOME@/bin/mapred --daemon stop %i
PIDFile=@PID_DIR@/hadoop-@HADOOP_USER@-%i.pid
SuccessExitStatus=143
Restart=on-failure
RestartSec=15
TimeoutStartSec=180
TimeoutStopSec=120
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
