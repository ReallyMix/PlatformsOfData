SPARK_VERSION=3.5.3
SPARK_URL=https://archive.apache.org/dist/spark/spark-$SPARK_VERSION/spark-$SPARK_VERSION-bin-hadoop3.tgz
SPARK_HOME=/opt/spark
HADOOP_HOME=/opt/hadoop
HIVE_HOME=/opt/hive
JAVA_HOME=/opt/java
HADOOP_USER=hadoop

HDFS_URL=hdfs://team-24-nn:9000
METASTORE_URI=thrift://team-24-en:9083
JDBC_URL="jdbc:hive2://team-24-en:10000/"

export JAVA_HOME HADOOP_HOME HIVE_HOME SPARK_HOME
export HADOOP_CONF_DIR=$HADOOP_HOME/etc/hadoop
export YARN_CONF_DIR=$HADOOP_HOME/etc/hadoop
export HADOOP_USER_NAME=$HADOOP_USER
